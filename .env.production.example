SLOTBRIDGE_ENVIRONMENT=production
SLOTBRIDGE_HOST=0.0.0.0

# Copy the Supabase Session pooler URL (port 5432), URL-encode the password,
# and require encrypted transport.
DATABASE_URL=postgresql://postgres.project-ref:managed-password@aws-0-region.pooler.supabase.com:5432/postgres?sslmode=require

# Generate this value outside Git with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-generated-random-secret-of-at-least-32-characters
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
AVAILABILITY_SLOT_INTERVAL_MINUTES=15

# A native Flutter app does not need CORS. Add only explicit HTTPS browser
# origins here if a browser client is introduced.
CORS_ALLOWED_ORIGINS=

# Portfolio mode: new CLIENT users may join only this already-seeded tenant.
PUBLIC_DEMO_REGISTRATION_ENABLED=true
PUBLIC_DEMO_ORGANIZATION_SLUG=slotbridge-demo

# Keep disabled during normal startup. Enable temporarily only for the explicit
# one-shot scripts/seed_production_demo.py command and provide DEMO_PASSWORD in
# the hosting provider's secret storage.
PRODUCTION_DEMO_SEED_ENABLED=false
# DEMO_PASSWORD=

ALLOW_UNSIGNED_DEMO_WEBHOOKS=false
# MINDBODY_WEBHOOK_SECRET=
# VAGARO_WEBHOOK_SECRET=
# GOOGLE_WEBHOOK_SECRET=

# Render Free has an ephemeral filesystem. This legacy demo store is separate
# from the persistent Supabase PostgreSQL booking database.
SLOTBRIDGE_DB_PATH=/tmp/slotbridge.db
SLOTBRIDGE_DEMO_MODE=false
