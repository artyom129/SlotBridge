SLOTBRIDGE_ENVIRONMENT=development
SLOTBRIDGE_HOST=0.0.0.0
SLOTBRIDGE_PORT=8000
CORS_ALLOWED_ORIGINS=

# PostgreSQL URL for commands run on the host.
DATABASE_URL=postgresql+psycopg://slotbridge:slotbridge_dev_only@127.0.0.1:5432/slotbridge
# PostgreSQL URL used by the backend container.
DATABASE_URL_DOCKER=postgresql+psycopg://slotbridge:slotbridge_dev_only@postgres:5432/slotbridge
POSTGRES_DB=slotbridge
POSTGRES_USER=slotbridge
POSTGRES_PASSWORD=slotbridge_dev_only

# Development placeholder only. Replace with a long random value outside demo/test.
JWT_SECRET=change-this-demo-only-jwt-secret-before-real-use
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
AVAILABILITY_SLOT_INTERVAL_MINUTES=15

# Optional Gemini assistant. Keep the real API key only in .env / Render secrets.
AI_PROVIDER=gemini
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=

# Development registration joins the active demo organization automatically.
# Production requires an explicit opt-in; see .env.production.example.
PUBLIC_DEMO_REGISTRATION_ENABLED=false
PUBLIC_DEMO_ORGANIZATION_SLUG=slotbridge-demo

# Production demo data is never seeded during application startup.
PRODUCTION_DEMO_SEED_ENABLED=false
# DEMO_PASSWORD=

# Unsigned webhooks are rejected by default. This switch is allowed only in
# development/test/demo and must be an explicit choice.
ALLOW_UNSIGNED_DEMO_WEBHOOKS=false
# Optional SlotBridge HMAC secrets for controlled ingress/proxy setups.
# MINDBODY_WEBHOOK_SECRET=
# VAGARO_WEBHOOK_SECRET=
# GOOGLE_WEBHOOK_SECRET=

# Legacy integration-gateway SQLite storage remains separate during migration.
SLOTBRIDGE_DB_PATH=data/slotbridge.db
SLOTBRIDGE_DEMO_MODE=true

MINDBODY_API_KEY=
MINDBODY_SITE_ID=

VAGARO_VERIFICATION_TOKEN=

GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_ACCESS_TOKEN=
